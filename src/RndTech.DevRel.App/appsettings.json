{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "",
    "CommandTimeout": 120
  },
  "Cache": {
    "RedisConnectionString": null,
    "ExpirationSeconds": 86400
  },
  "Server": {
    "Port": 29500
  },
  "FilterConfiguration": {
    "AgeRanges": {
      "18-25": { "Min": 18, "Max": 25 },
      "26-35": { "Min": 26, "Max": 35 },
      "36-45": { "Min": 36, "Max": 45 },
      "46-55": { "Min": 46, "Max": 55 },
      "56-65": { "Min": 56, "Max": 65 }
    },
    "LanguageMappings": {
      "JavaScript / TypeScript": ["JavaScript", "TypeScript", "JS", "TS"]
    }
  }
}
