# Database connection
DEVRELAPP_CONFIG_DATABASE=Server=localhost;Port=5432;Database=devrel;User Id=postgres;Password=yourpassword

# Redis connection (optional for development)
# DEVRELAPP_CONFIG_REDIS=localhost:6379

# Application port (optional, default: 29500)
# PORT=29500

# Environment
ASPNETCORE_ENVIRONMENT=Development

# Frontend proxy (for development)
ASPNETCORE_URLS=http://localhost:29500
SPA_PROXY_SERVER_URL=https://localhost:44422